# ───────────────────────────────────────────────────────────────
# Site
# ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ghassan-ahmed.dev


# ───────────────────────────────────────────────────────────────
# Contact form (Section: Contact)
# Pick ONE provider — Formspree (easiest) OR Resend.
# ───────────────────────────────────────────────────────────────

# A — Formspree (free 50 submissions/mo)
# Create a form at https://formspree.io, paste the id (after /f/)
NEXT_PUBLIC_FORMSPREE_ID=

# B — Resend (transactional email, free 100/day)
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=gssan1018@gmail.com


# ───────────────────────────────────────────────────────────────
# Digital Ghassan AI chat (floating widget, bottom-right)
#
# WARNING — these are FULL GOOGLE ACCOUNT cookies, NOT API tokens.
# Anyone with access to your server gets full access to the linked
# Google account (Gmail, Drive, everything). STRONG recommendations:
#
#   1. Use a SEPARATE Google account dedicated to this site.
#   2. NEVER commit .env.local. Confirm it's in .gitignore.
#   3. Set CHAT_ENABLED=false to kill the chat instantly.
#   4. Cookies rotate. __Secure-1PSIDTS expires every ~10 min; the
#      vendored client auto-refreshes. __Secure-1PSID lasts months
#      but eventually needs re-export from the browser.
#
# How to get them:
#   - Sign into gemini.google.com in a Chrome incognito window
#   - DevTools (F12) → Application → Cookies → gemini.google.com
#   - Copy values of __Secure-1PSID and __Secure-1PSIDTS
# ───────────────────────────────────────────────────────────────
GEMINI_SECURE_1PSID=
GEMINI_SECURE_1PSIDTS=

# Set to "false" to disable the chat at runtime without redeploying.
CHAT_ENABLED=true
